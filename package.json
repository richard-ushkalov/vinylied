{
  "name": "vinilyed",
  "version": "2.0.0",
  "private": true,
  "description": "Музыкальный плеер-полка с виниловыми пластинками: офлайн, PWA, Android и iPhone",
  "type": "module",
  "scripts": {
    "serve": "http-server . -p 4173 -c-1 --silent",
    "vendor": "node tools/vendor.mjs",
    "icons": "node tools/make-icons.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "test": "node --test tests/unit/",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@unimusic/chromaprint": "^0.1.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "http-server": "^14.1.1",
    "music-metadata": "^11.16.0",
    "typescript": "6.0.2"
  }
}
